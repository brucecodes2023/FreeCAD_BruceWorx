<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>BruceWorxPreferences</class>
 <widget class="QWidget" name="BruceWorxPreferences">
  <property name="windowTitle">
   <string>BruceWorx</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="groupDefaults">
     <property name="title">
      <string>BruceWorx features</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutDefaults">
      <item>
       <widget class="QLabel" name="labelDefaults">
        <property name="text">
         <string>Everything BruceWorx adds is on by default. Uncheck a box to turn that feature off.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="PreferencePack">
        <property name="toolTip">
         <string>On by default. Applied once on first start (theme, millimetres, Fusion-like navigation, PartDesign startup). Your previous values are saved first. Uncheck to restore them (same as the BruceWorx Off pack); check to apply the light pack again. Preferences &gt; General &gt; Theme still picks BruceWorx Dark or another theme.</string>
        </property>
        <property name="text">
         <string>BruceWorx preference pack</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>PreferencePack</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="HistoryTimelineEnabled">
        <property name="toolTip">
         <string>On by default. Same switch as BruceWorx &gt; History Timeline. Closing the dock also turns it off.</string>
        </property>
        <property name="text">
         <string>History timeline (bottom PartDesign history bar)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>Enabled</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>Mod/HistoryTimeline</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="LoadHooks">
        <property name="toolTip">
         <string>On by default. Loads the BruceWorx hooks add-on (Mod/BruceWorxHooks). Takes effect on the next start. The FreeCADCmd hooks.py CLI does not depend on this box.</string>
        </property>
        <property name="text">
         <string>Hooks add-on (part numbers: BruceWorx &gt; Assign Part Number…)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>LoadHooks</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FileModelTools">
        <property name="toolTip">
         <string>On by default. Adds Make Parts External…, Pack and Go… and Fix Broken References… to the BruceWorx menu (one part per file, assemblies link part files by relative path). Needs the hooks add-on. Takes effect on the next start. The make-external, pack-and-go and resolve-refs CLI commands do not depend on this box.</string>
        </property>
        <property name="text">
         <string>One part per file (Make Parts External, Pack and Go, Fix Broken References)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FileModelTools</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="PatternCommands">
        <property name="toolTip">
         <string>On by default. Adds Rectangular Pattern and Circular Pattern to the PartDesign and Assembly toolbars and to the BruceWorx menu. They pattern features (through PartDesign), bodies and assembly components. Takes effect on the next workbench switch.</string>
        </property>
        <property name="text">
         <string>Rectangular and Circular Pattern commands</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>PatternCommands</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="UseBruceWorxBar">
        <property name="toolTip">
         <string>On by default. Add-ons that replace the toolbar area (FreeCAD-Ribbon) are not loaded while this is on; they stay installed, and stock FreeCAD still loads them. Takes effect on the next start.</string>
        </property>
        <property name="text">
         <string>BruceWorx top bar (turns the FreeCAD-Ribbon add-on off)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>UseBruceWorxBar</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="CompactToolbars">
        <property name="toolTip">
         <string>On by default. After each workbench switch, File, the workbench tabs and View share the first toolbar row and the workbench's tools follow on the second.</string>
        </property>
        <property name="text">
         <string>Two toolbar rows</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>CompactToolbars</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FollowSystemAppearance">
        <property name="toolTip">
         <string>On by default. Switches between the BruceWorx and BruceWorx Dark values (theme, viewport, view cube, edges) when macOS changes appearance. Uncheck to keep the theme picked on Preferences &gt; General.</string>
        </property>
        <property name="text">
         <string>Follow the macOS light/dark setting</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FollowSystemAppearance</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FollowSystemAccent">
        <property name="toolTip">
         <string>On by default. The accent from System Settings &gt; Appearance colours buttons, checkboxes, selection and the view cube highlight. Text on it turns dark when white would be hard to read.</string>
        </property>
        <property name="text">
         <string>Use the macOS accent colour</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FollowSystemAccent</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="layoutSketchGrid">
        <item>
         <widget class="QLabel" name="labelSketchGridStrength">
          <property name="text">
           <string>Sketch grid strength</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="Gui::PrefSpinBox" name="SketchGridStrength">
          <property name="toolTip">
           <string>How visible the sketch grid is: white lines on dark, black on light, at this opacity. Open sketches update at once. Python: bruceworx_grid.set_strength(14)</string>
          </property>
          <property name="suffix">
           <string> %</string>
          </property>
          <property name="minimum">
           <number>2</number>
          </property>
          <property name="maximum">
           <number>40</number>
          </property>
          <property name="value">
           <number>10</number>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>SketchGridStrength</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="spacerSketchGrid">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupMacTitleBar">
     <property name="title">
      <string>macOS window</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutMac">
      <item>
       <widget class="QLabel" name="labelMac">
        <property name="text">
         <string>On by default. Unified title bar and toolbar, with the native close, minimize, and zoom buttons in that bar. Uncheck to restore the stock title bar. macOS only; other systems store the preference and ignore it. Qt 6.8 documents painting problems for this mode when the window contains an OpenGL view (the 3D view) or when toolbars are moved. Confirm that on a Mac.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="UnifiedTitleAndToolBar">
        <property name="toolTip">
         <string>On by default. Calls QMainWindow.setUnifiedTitleAndToolBarOnMac. Uncheck to set that property false, which is Qt stock. Known risk: Qt 6.8 documents painting problems when the window contains an OpenGL view or movable toolbars. Verify on a Mac.</string>
        </property>
        <property name="text">
         <string>Unified title bar and toolbar on macOS</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>UnifiedTitleAndToolBar</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>MainWindow</cstring>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupModelTree">
     <property name="title">
      <string>Floating model tree</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutTree">
      <item>
       <widget class="QLabel" name="labelTree">
        <property name="text">
         <string>On by default. Puts the model tree on the existing left overlay panel (auto-hide, transparency, width, and insets below). Uncheck to write the previous overlay settings back and restore the stock docks. The panel stays pinned to the left edge; a free-floating position needs a later OverlayManager change.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FloatingModelTree">
        <property name="toolTip">
         <string>On by default. Overlay the Model dock (or Tree view, if the panels are split). Uncheck to restore the stock docks.</string>
        </property>
        <property name="text">
         <string>Overlay the model tree</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FloatingModelTree</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FloatingTaskPanel">
        <property name="toolTip">
         <string>On by default. While the model tree floats, the task panel floats on the right as a card that shows while a command is open. Uncheck to dock it again.</string>
        </property>
        <property name="text">
         <string>Float the task panel (command dialog)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FloatingTaskPanel</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FloatingModelTreeAutoHide">
        <property name="toolTip">
         <string>OverlayLeft AutoHide. The panel hides when the pointer leaves and shows on hover.</string>
        </property>
        <property name="text">
         <string>Auto-hide</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FloatingModelTreeAutoHide</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="Gui::PrefCheckBox" name="FloatingModelTreeTransparent">
        <property name="toolTip">
         <string>On by default. OverlayLeft Transparent: the model shows through the Browser; the text keeps a halo so it stays readable. Uncheck for an opaque card.</string>
        </property>
        <property name="text">
         <string>Transparent background</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="prefEntry" stdset="0">
         <cstring>FloatingModelTreeTransparent</cstring>
        </property>
        <property name="prefPath" stdset="0">
         <cstring>BruceWorx</cstring>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="formLayoutTree">
        <item row="0" column="0">
         <widget class="QLabel" name="labelWidth">
          <property name="text">
           <string>Width</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="Gui::PrefSpinBox" name="FloatingModelTreeWidth">
          <property name="toolTip">
           <string>OverlayLeft Width. Values of 100 or below are treated as broken by FreeCAD and ignored.</string>
          </property>
          <property name="suffix">
           <string> px</string>
          </property>
          <property name="minimum">
           <number>120</number>
          </property>
          <property name="maximum">
           <number>2000</number>
          </property>
          <property name="value">
           <number>280</number>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>FloatingModelTreeWidth</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="labelTop">
          <property name="text">
           <string>Top offset</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="Gui::PrefSpinBox" name="FloatingModelTreeTopOffset">
          <property name="toolTip">
           <string>OverlayLeft Offset1. Moves the panel down from the top of the window.</string>
          </property>
          <property name="suffix">
           <string> px</string>
          </property>
          <property name="minimum">
           <number>0</number>
          </property>
          <property name="maximum">
           <number>2000</number>
          </property>
          <property name="value">
           <number>8</number>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>FloatingModelTreeTopOffset</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="labelBottom">
          <property name="text">
           <string>Bottom inset</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="Gui::PrefSpinBox" name="FloatingModelTreeBottomInset">
          <property name="toolTip">
           <string>OverlayLeft Offset2. Shortens the panel from the bottom. Height otherwise fills the side.</string>
          </property>
          <property name="suffix">
           <string> px</string>
          </property>
          <property name="minimum">
           <number>0</number>
          </property>
          <property name="maximum">
           <number>2000</number>
          </property>
          <property name="value">
           <number>8</number>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>FloatingModelTreeBottomInset</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="labelLeft">
          <property name="text">
           <string>Left inset</string>
          </property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="Gui::PrefSpinBox" name="FloatingModelTreeLeftInset">
          <property name="toolTip">
           <string>Saved as OverlayLeft Offset3. The current overlay pins the left panel to the edge, so this inset is stored and not applied yet.</string>
          </property>
          <property name="suffix">
           <string> px</string>
          </property>
          <property name="minimum">
           <number>0</number>
          </property>
          <property name="maximum">
           <number>2000</number>
          </property>
          <property name="value">
           <number>8</number>
          </property>
          <property name="prefEntry" stdset="0">
           <cstring>FloatingModelTreeLeftInset</cstring>
          </property>
          <property name="prefPath" stdset="0">
           <cstring>BruceWorx</cstring>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>20</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>Gui::PrefCheckBox</class>
